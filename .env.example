# Ativa a camada de mocks (MSW REST + Socket.IO). Obrigatório no build de demonstração.
VITE_ENABLE_MOCKS=true

# Base das chamadas REST (interceptadas pelo MSW quando os mocks estão ativos).
VITE_API_URL=/api

# Endereço do servidor Socket.IO. Com mocks, o MSW intercepta este WebSocket.
VITE_SOCKET_URL=wss://realtime.kurio.mock

# Cenário inicial dos mocks (default, fast, slow, variable, out-of-order, offline,
# server-error, flaky, empty, favorites-fail, payment-rejected, order-timeout,
# price-change-at-checkout, sold-out-at-checkout, wallet-rejected, short-session).
VITE_MOCK_SCENARIO=default
